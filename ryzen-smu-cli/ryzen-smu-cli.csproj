<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ryzen_smu_cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.0</Version>
    <LangVersion>12</LangVersion>
    <Authors>Terry577 and contributors</Authors>
    <Description>Windows CLI for selected AMD Ryzen SMU operations.</Description>
    <RepositoryUrl>https://github.com/Terry577/Arca-ryzen-smu-cli</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Terry577/Arca-ryzen-smu-cli</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="include\ZenStates-Core\**\*.cs" />
    <ProjectReference
      Include="include\ZenStates-Core\ZenStates-Core.csproj"
      AdditionalProperties="IsWindows=false;TargetFrameworks=net8.0-windows" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="native\win-x64\inpoutx64.dll">
      <Link>inpoutx64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="include\ZenStates-Core\External\InpOut\license.txt">
      <Link>InpOut.LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="include\ZenStates-Core\Resources\PawnIo\COPYING">
      <Link>PawnIO.COPYING.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="include\ZenStates-Core\LICENSE">
      <Link>ZenStates-Core.LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\LICENSE">
      <Link>ryzen-smu-cli.LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\README.md">
      <Link>ryzen-smu-cli.README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\CHANGELOG.md">
      <Link>CHANGELOG.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="RemoveAmbiguousDependencyDocuments" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'LICENSE' Or
                   '%(ResolvedFileToPublish.RelativePath)' == 'README.md' Or
                   '%(ResolvedFileToPublish.RelativePath)' == 'ZenStates-Core.LICENSE.txt'" />
      <!--
        The project reference also contributes the same source file as
        LICENSE. Publish conflict resolution can otherwise discard this
        renamed item before the ambiguous dependency document is removed.
        Re-add it after ComputeFilesToPublish so every publish path has one
        deterministic, inspectable ZenStates-Core license name.
      -->
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\include\ZenStates-Core\LICENSE">
        <RelativePath>ZenStates-Core.LICENSE.txt</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="VerifyRequiredPublishContents" AfterTargets="Publish">
    <ItemGroup>
      <_RequiredPublishedFile Include="$(PublishDir)ryzen-smu-cli.exe" />
      <_RequiredPublishedFile Include="$(PublishDir)inpoutx64.dll" />
      <_RequiredPublishedFile Include="$(PublishDir)InpOut.LICENSE.txt" />
      <_RequiredPublishedFile Include="$(PublishDir)PawnIO.COPYING.txt" />
      <_RequiredPublishedFile Include="$(PublishDir)ZenStates-Core.LICENSE.txt" />
      <_RequiredPublishedFile Include="$(PublishDir)ryzen-smu-cli.LICENSE.txt" />
      <_RequiredPublishedFile Include="$(PublishDir)THIRD-PARTY-NOTICES.md" />
      <_RequiredPublishedFile Include="$(PublishDir)ryzen-smu-cli.README.md" />
      <_RequiredPublishedFile Include="$(PublishDir)CHANGELOG.md" />
    </ItemGroup>
    <Error
      Condition="!Exists('%(_RequiredPublishedFile.Identity)')"
      Text="Required published file '%(_RequiredPublishedFile.Filename)%(_RequiredPublishedFile.Extension)' is missing." />
  </Target>
</Project>
